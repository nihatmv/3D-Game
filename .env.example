# Copy to .env.local (git-ignored) or set these in your host's dashboard.

# Final public URL, no trailing slash. Used for the social preview (og:image needs an absolute URL).
VITE_SITE_URL=https://your-site.vercel.app

# Analytics (optional). Leave empty to send nothing.
VITE_ANALYTICS_PROVIDER=
# For plausible:
VITE_PLAUSIBLE_DOMAIN=
